# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name (created automatically on first use)
MONGODB_DB=stock_control_room

# Shared code the teams enter to open the app. Leave empty to leave the app open.
APP_ACCESS_CODE=

# Code for the Admin page and for correcting previous days. Leave empty to leave admin open.
ADMIN_ACCESS_CODE=
